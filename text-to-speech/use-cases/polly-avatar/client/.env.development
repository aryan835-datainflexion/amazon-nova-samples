# Local development config (used by `npm run dev`).
#
# No AWS resources are required to run locally: auth is disabled and the client
# talks to the standalone WebSocket server on ws://localhost:8080. Cognito and
# other AWS-specific values only exist when deployed, where the server serves
# them as /config.json (read at runtime, see src/config.ts). No .env.production
# is needed.
VITE_AUTH_ENABLED=false

# Optional: point the client at a WebSocket server other than localhost:8080.
# VITE_WS_URL=ws://localhost:8080
